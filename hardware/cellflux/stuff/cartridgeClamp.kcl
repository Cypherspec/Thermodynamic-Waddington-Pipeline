// Cartridge clamp
// Open central frame retains the chip without blocking ports.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

import frame, cylinder from "geometry.kcl"
stock = frame(
  width = 95mm,
  depth = 45mm,
  openingWidth = 69mm,
  openingDepth = 23mm,
  height = 3mm,
)
mountTool = cylinder(sizeDiameter = 3.4mm, height = 5mm)
  |> translate(
       x = -42mm,
       y = -17mm,
       z = -1mm,
       global = true,
     )
  |> patternLinear3d(instances = 2, distance = 84mm, axis = X)
  |> patternLinear3d(instances = 2, distance = 34mm, axis = Y)
clamp = subtract(stock, tools = mountTool)
  |> appearance(color = "#46a2af", metalness = 65)
