// Flow sensor envelope
// Inline sensor with a real longitudinal flow passage.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

import plate, cylinder from "geometry.kcl"
stock = plate(width = 18mm, depth = 35mm, height = 16mm)
bore = cylinder(sizeDiameter = 2mm, height = 37mm)
  |> rotate(axis = X, angle = 90deg, global = true)
  |> translate(y = 18.5mm, z = 8mm, global = true)
sensor = subtract(stock, tools = [bore])
  |> appearance(color = "#73a4ad", metalness = 40)
