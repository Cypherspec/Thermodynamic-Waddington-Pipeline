// Optical breadboard
// Thick support with a modest grid of true mounting holes.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

import plate, cylinder from "geometry.kcl"
stock = plate(width = 430mm, depth = 350mm, height = 25mm)
holeTool = cylinder(sizeDiameter = 6mm, height = 27mm)
  |> translate(
       x = -175mm,
       y = -125mm,
       z = -1mm,
       global = true,
     )
  |> patternLinear3d(instances = 8, distance = 50mm, axis = X)
  |> patternLinear3d(instances = 6, distance = 50mm, axis = Y)
breadboard = subtract(stock, tools = holeTool)
  |> appearance(color = "#677682", metalness = 85)
