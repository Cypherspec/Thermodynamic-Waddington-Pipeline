// Solenoid valve envelope
// Separate bought-part stand-in with a transverse fluid passage.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

import plate, cylinder from "geometry.kcl"
stock = plate(width = 20mm, depth = 36mm, height = 40mm)
bore = cylinder(sizeDiameter = 3mm, height = 38mm)
  |> rotate(axis = X, angle = 90deg, global = true)
  |> translate(y = 19mm, z = 10mm, global = true)
valve = subtract(stock, tools = [bore])
  |> appearance(color = "#314a61", metalness = 50)
