// Incubation chamber frame
// Removable environmental hood with gas inlet and optical opening.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

import frame, cylinder from "geometry.kcl"
stock = frame(
  width = 280mm,
  depth = 170mm,
  openingWidth = 270mm,
  openingDepth = 160mm,
  height = 65mm,
)
gasTool = cylinder(sizeDiameter = 6mm, height = 12mm)
  |> rotate(axis = Y, angle = 90deg, global = true)
  |> translate(x = 132mm, z = 45mm, global = true)
hood = subtract(stock, tools = [gasTool])
  |> appearance(color = "#b6dbde", opacity = 25)
