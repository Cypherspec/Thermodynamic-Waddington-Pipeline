// Closed-loop gas mixer envelope
// Separate environmental controller with twin gas ports.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

import plate, cylinder from "geometry.kcl"
stock = plate(width = 95mm, depth = 70mm, height = 45mm)
ports = cylinder(sizeDiameter = 6mm, height = 10mm)
  |> rotate(axis = X, angle = 90deg, global = true)
  |> translate(
       x = -25mm,
       y = -27mm,
       z = 20mm,
       global = true,
     )
  |> patternLinear3d(instances = 2, distance = 50mm, axis = X)
gasMixer = subtract(stock, tools = ports)
  |> appearance(color = "#c1d1d4", metalness = 45)
