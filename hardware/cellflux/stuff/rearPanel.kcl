// Rear service panel
// Ventilation opening and utility pass-throughs.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

import plate, cylinder from "geometry.kcl"
stock = plate(width = 810mm, depth = 590mm, height = 3mm)
fanTool = cylinder(sizeDiameter = 100mm, height = 5mm)
  |> translate(
       x = -270mm,
       y = -180mm,
       z = -1mm,
       global = true,
     )
utilityTool = cylinder(sizeDiameter = 25mm, height = 5mm)
  |> translate(
       x = 200mm,
       y = -220mm,
       z = -1mm,
       global = true,
     )
  |> patternLinear3d(instances = 4, distance = 40mm, axis = X)
vented = subtract(stock, tools = [fanTool])
rearPanel = subtract(vented, tools = utilityTool)
  |> appearance(color = "#bac8d0", metalness = 40)
