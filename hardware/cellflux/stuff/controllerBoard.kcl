// Acquisition controller board
// PCB envelope with four mounting holes; not an electrical schematic.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

import plate, cylinder from "geometry.kcl"
stock = plate(width = 140mm, depth = 115mm, height = 1.6mm)
mounts = cylinder(sizeDiameter = 3.2mm, height = 3.6mm)
  |> rotate(axis = Z, angle = 17deg, global = true)
  |> translate(
       x = -62mm,
       y = -49mm,
       z = -1mm,
       global = true,
     )
  |> patternLinear3d(instances = 2, distance = 124mm, axis = X)
  |> patternLinear3d(instances = 2, distance = 98mm, axis = Y)
board = subtract(stock, tools = mounts)
  |> appearance(color = "#27785f", roughness = 65)
