// Wet bay spill tray
// Open topped secondary containment with a raised perimeter.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

import plate from "geometry.kcl"
stock = plate(width = 290mm, depth = 300mm, height = 22mm)
cavity = plate(width = 282mm, depth = 292mm, height = 22mm)
  |> translate(z = 3mm, global = true)
tray = subtract(stock, tools = [cavity])
  |> appearance(color = "#8babb5", metalness = 65)
