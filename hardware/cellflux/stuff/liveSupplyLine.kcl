// Live cartridge supply route
// Curved line from chip tail to selector common port; local endpoints dimensioned.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

import archTube from "fluidRouting.kcl"
lineSpan = 350mm
supplyLine = archTube(
  span = lineSpan,
  crest = 145mm,
  terminalZ = -94.87mm,
  bendRadius = 10mm,
)
  |> appearance(color = "#438eab")
