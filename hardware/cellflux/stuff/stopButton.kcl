// Emergency stop actuator
// Red mushroom actuator envelope; no certified safety function implied.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

import cylinder from "geometry.kcl"
stem = cylinder(sizeDiameter = 22mm, height = 12mm)
head = cylinder(sizeDiameter = 40mm, height = 13mm)
  |> translate(z = 11mm, global = true)
stopButton = union([stem, head])
  |> appearance(color = "#c3443d", roughness = 45)
