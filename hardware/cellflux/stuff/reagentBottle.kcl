// Reagent reservoir
// Hollow cylindrical vessel with a bottom; pressure rating unassigned.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

import cylinder from "geometry.kcl"
outerDiameter = 46mm
wallThickness = 2mm
reservoirHeight = 90mm
stock = cylinder(sizeDiameter = outerDiameter, height = reservoirHeight)
cavity = cylinder(sizeDiameter = outerDiameter - (2 * wallThickness), height = reservoirHeight)
  |> translate(z = 3mm, global = true)
reservoir = subtract(stock, tools = [cavity])
  |> appearance(color = "#bfdee0", opacity = 35)
