// Reservoir closure
// Removable cap with two open pneumatic and fluid connection bores.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

import cylinder from "geometry.kcl"
stock = cylinder(sizeDiameter = 50mm, height = 10mm)
seat = cylinder(sizeDiameter = 46.3mm, height = 5mm)
  |> translate(z = -1mm, global = true)
ports = cylinder(sizeDiameter = 4mm, height = 12mm)
  |> rotate(axis = Z, angle = 17deg, global = true)
  |> translate(x = -8mm, z = -1mm, global = true)
  |> patternLinear3d(instances = 2, distance = 16mm, axis = X)
seated = subtract(stock, tools = [seat])
cap = subtract(seated, tools = ports)
  |> appearance(color = "#1b738d", metalness = 30)
