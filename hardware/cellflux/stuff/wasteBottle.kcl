// Waste collection vessel
// Separate wide-mouth containment bottle with a real cavity.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

import cylinder from "geometry.kcl"
stock = cylinder(sizeDiameter = 70mm, height = 110mm)
cavity = cylinder(sizeDiameter = 64mm, height = 110mm)
  |> translate(z = 4mm, global = true)
wasteBottle = subtract(stock, tools = [cavity])
  |> appearance(color = "#d5b884", opacity = 60)
