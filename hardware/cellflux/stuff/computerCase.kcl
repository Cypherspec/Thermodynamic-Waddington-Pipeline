// Industrial acquisition computer
// Vented compute enclosure; internals are installation envelopes.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

import plate from "geometry.kcl"
stock = plate(width = 165mm, depth = 150mm, height = 120mm)
cavity = plate(width = 159mm, depth = 144mm, height = 120mm)
  |> translate(z = 3mm, global = true)
vents = plate(width = 5mm, depth = 152mm, height = 4mm)
  |> translate(x = -65mm, z = 30mm, global = true)
  |> patternLinear3d(instances = 12, distance = 12mm, axis = X)
opened = subtract(stock, tools = [cavity])
computerCase = subtract(opened, tools = vents)
  |> appearance(color = "#394b5d", metalness = 65)
