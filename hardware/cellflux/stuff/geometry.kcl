// Parametric manufacturing primitives
// Repeated dimension-driven profiles for instrument parts.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

export fn plate(width, depth, height) {
  outline = sketch(on = XY) {
    bottom = line(start = [var -5mm, var -4mm], end = [var 5mm, var -4mm])
    right = line(start = [var 5mm, var -4mm], end = [var 5mm, var 4mm])
    top = line(start = [var 5mm, var 4mm], end = [var -5mm, var 4mm])
    left = line(start = [var -5mm, var 4mm], end = [var -5mm, var -4mm])
    coincident([bottom.end, right.start])
    coincident([right.end, top.start])
    coincident([top.end, left.start])
    coincident([left.end, bottom.start])
    horizontal(bottom)
    horizontal(top)
    vertical(right)
    vertical(left)
    horizontalDistance([bottom.start, bottom.end]) == width
    verticalDistance([right.start, right.end]) == depth
    horizontalDistance([ORIGIN, bottom.start]) == -width / 2
    verticalDistance([ORIGIN, bottom.start]) == -depth / 2
  }
  plateBody = extrude(region(segments = [outline.bottom, outline.right], intersectionIndex = -1, direction = CCW), length = height)
  hide(outline)
  return plateBody
}

export fn cylinder(sizeDiameter, height) {
  section = sketch(on = XY) {
    rim = circle(start = [var 5mm, var 0mm], center = [var 0mm, var 0mm])
    coincident([rim.center, ORIGIN])
    radius(rim) == sizeDiameter / 2
    horizontal([rim.center, rim.start])
  }
  cylinderBody = extrude(region(segments = [section.rim]), length = height)
  hide(section)
  return cylinderBody
}

export fn tube(outerDiameter, innerDiameter, height) {
  outside = cylinder(sizeDiameter = outerDiameter, height = height)
  inside = cylinder(sizeDiameter = innerDiameter, height = height + 2mm)
    |> translate(z = -1mm, global = true)
  tubeBody = subtract(outside, tools = [inside])
  return tubeBody
}

export fn frame(width, depth, openingWidth, openingDepth, height) {
  stock = plate(width = width, depth = depth, height = height)
  opening = plate(width = openingWidth, depth = openingDepth, height = height + 2mm)
    |> translate(z = -1mm, global = true)
  frameBody = subtract(stock, tools = [opening])
  return frameBody
}
