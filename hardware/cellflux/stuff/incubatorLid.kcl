// Incubator lid
// Optical aperture and tubing clearances in removable clear lid.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

import plate, cylinder from "geometry.kcl"
stock = plate(width = 280mm, depth = 170mm, height = 3mm)
lightTool = cylinder(sizeDiameter = 50mm, height = 5mm)
  |> translate(x = -65mm, z = -1mm, global = true)
windowSeat = cylinder(sizeDiameter = 54.2mm, height = 2.5mm)
  |> translate(x = -65mm, z = -1mm, global = true)
portTools = cylinder(sizeDiameter = 3mm, height = 5mm)
  |> translate(x = -95mm, z = -1mm, global = true)
  |> patternLinear3d(instances = 2, distance = 60mm, axis = X)
  |> patternLinear3d(instances = 2, distance = 130mm, axis = X)
oilTools = cylinder(sizeDiameter = 3mm, height = 5mm)
  |> translate(
       x = 65mm,
       y = -8mm,
       z = -1mm,
       global = true,
     )
  |> patternLinear3d(instances = 2, distance = 16mm, axis = Y)
beadTool = cylinder(sizeDiameter = 3mm, height = 5mm)
  |> translate(
       x = 50mm,
       y = 8mm,
       z = -1mm,
       global = true,
     )
windowed = subtract(stock, tools = [lightTool, windowSeat])
ported = subtract(windowed, tools = portTools)
oiled = subtract(ported, tools = oilTools)
lid = subtract(oiled, tools = [beadTool])
  |> appearance(color = "#b0d9dc", opacity = 25)
