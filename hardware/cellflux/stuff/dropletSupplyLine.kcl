// Droplet cell suspension route
// Continuous tube includes the reservoir dip leg.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

import archTube from "fluidRouting.kcl"
lineSpan = sqrt(323_ * 323_ + 75_ * 75_) * 1mm
cellLine = archTube(
  span = lineSpan,
  crest = 95mm,
  terminalZ = -271.87mm,
  bendRadius = 10mm,
)
  |> appearance(color = "#73baad")
