// Collection inlet grommet
// Six millimetre lid bore to nominal one millimetre collection tubing.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

import cylinder from "geometry.kcl"
stem = cylinder(sizeDiameter = 6mm, height = 3.2mm)
flange = cylinder(sizeDiameter = 8mm, height = 1mm)
  |> translate(z = 3mm, global = true)
stock = union([stem, flange])
bore = cylinder(sizeDiameter = 1mm, height = 6mm)
  |> translate(z = -1mm, global = true)
grommet = subtract(stock, tools = [bore])
  |> appearance(color = "#383c40")
