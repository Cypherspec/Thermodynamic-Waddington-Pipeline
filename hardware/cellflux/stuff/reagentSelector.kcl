// Reagent valve interface
// Six-to-one selector installation envelope with isolated port recesses.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

import plate, cylinder from "geometry.kcl"
stock = plate(width = 60mm, depth = 60mm, height = 35mm)
common = cylinder(sizeDiameter = 1.05mm, height = 7mm)
  |> translate(z = 30mm, global = true)
inputs = cylinder(sizeDiameter = 1.05mm, height = 7mm)
  |> translate(
       x = -20mm,
       y = -20mm,
       z = 30mm,
       global = true,
     )
  |> patternLinear3d(instances = 3, distance = 20mm, axis = X)
  |> patternLinear3d(instances = 2, distance = 40mm, axis = Y)
opened = subtract(stock, tools = [common])
selector = subtract(opened, tools = inputs)
  |> appearance(color = "#3c697f", metalness = 60)
