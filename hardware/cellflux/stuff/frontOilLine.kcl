// Front oil supply route
// Continuous tube from oil reservoir to the front focusing inlet.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

import archTube from "fluidRouting.kcl"
lineSpan = sqrt(363_ * 363_ + 67_ * 67_) * 1mm
oilLine = archTube(
  span = lineSpan,
  crest = 110mm,
  terminalZ = -271.87mm,
  bendRadius = 10mm,
)
  |> appearance(color = "#698ecc")
