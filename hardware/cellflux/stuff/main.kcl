serviceLift = 0mm
serviceSpread = 0mm
baseHeight = 30mm
frameBottom = 50mm
base = translate(basePlate, z = baseHeight, global = true)
feet = translate(
  isolationFoot,
  x = -390mm,
  y = -270mm,
  global = true,
)
  |> patternLinear3d(instances = 2, distance = 780mm, axis = X)
  |> patternLinear3d(instances = 2, distance = 540mm, axis = Y)
posts = translate(
  upright,
  x = -425mm,
  y = -300mm,
  z = frameBottom,
  global = true,
)
  |> patternLinear3d(instances = 2, distance = 850mm, axis = X)
  |> patternLinear3d(instances = 2, distance = 600mm, axis = Y)
topCover = translate(roof, z = 650mm + serviceLift, global = true)
leftPanel = rotate(
  sidePanel,
  axis = Y,
  angle = 90deg,
  global = true,
)
  |> rotate(axis = X, angle = 90deg, global = true)
  |> translate(x = -445mm - serviceSpread, z = 350mm, global = true)
rightPanel = clone(leftPanel)
  |> translate(x = 887mm + 2 * serviceSpread, global = true)
leftGlass = rotate(
  sideWindow,
  axis = Y,
  angle = 90deg,
  global = true,
)
  |> rotate(axis = X, angle = 90deg, global = true)
  |> translate(x = -441mm - serviceSpread, z = 350mm, global = true)
rightGlass = clone(leftGlass)
  |> translate(x = 879mm + 2 * serviceSpread, global = true)
backCover = rotate(
  rearPanel,
  axis = X,
  angle = 90deg,
  global = true,
)
  |> translate(y = 315mm + serviceSpread, z = 350mm, global = true)
leftDoor = rotate(
  frontDoor,
  axis = X,
  angle = 90deg,
  global = true,
)
  |> translate(
       x = -203mm,
       y = -315mm - serviceSpread,
       z = 350mm,
       global = true,
     )
rightDoor = clone(leftDoor)
  |> translate(x = 406mm, global = true)
leftDoorGlass = rotate(
  doorWindow,
  axis = X,
  angle = 90deg,
  global = true,
)
  |> translate(
       x = -203mm,
       y = -311mm - serviceSpread,
       z = 350mm,
       global = true,
     )
rightDoorGlass = clone(leftDoorGlass)
  |> translate(x = 406mm, global = true)
opticalTable = translate(
