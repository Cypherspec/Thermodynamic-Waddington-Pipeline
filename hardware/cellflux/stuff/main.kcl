mediaFeed = rotate(
  mediaSupplyLine,
  axis = Z,
  angle = atan2(y = 15mm, x = 263mm),
  global = true,
)
  |> translate(
       x = 70mm,
       y = -85mm,
       z = 247mm,
       global = true,
     )
perturbationFeed = rotate(
  perturbationLine,
  axis = Z,
  angle = atan2(y = -25mm, x = 123mm),
  global = true,
)
  |> translate(
       x = 70mm,
       y = -45mm,
       z = 247mm,
       global = true,
     )
mediaReservoirSeal = clone(rearOilReservoirSeal)
  |> translate(x = 70mm, global = true)
perturbationReservoirSeal = clone(rearOilReservoirSeal)
  |> translate(x = -70mm, global = true)
unusedSelectorPlugs = translate(
  selectorPlug,
  x = 90mm,
  y = -85mm,
  z = 245mm,
  global = true,
)
  |> patternLinear3d(instances = 2, distance = 20mm, axis = X)
  |> patternLinear3d(instances = 2, distance = 40mm, axis = Y)
