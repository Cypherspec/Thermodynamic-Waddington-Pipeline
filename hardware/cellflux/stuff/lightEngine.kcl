// Four colour excitation engine
// Enclosed light source envelope with optical output coupling recess.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

import plate, cylinder from "geometry.kcl"
stock = plate(width = 100mm, depth = 100mm, height = 65mm)
outputTool = cylinder(sizeDiameter = 14mm, height = 15mm)
  |> rotate(axis = Y, angle = 90deg, global = true)
  |> translate(x = 40mm, z = 32.5mm, global = true)
lightEngine = subtract(stock, tools = [outputTool])
  |> appearance(color = "#31566d", metalness = 55)
