// Light engine support pedestal
// Cantilever bracket clears the optical breadboard below the source.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

import plate from "geometry.kcl"
leg = plate(width = 20mm, depth = 60mm, height = 135.5mm)
  |> translate(x = -35mm, global = true)
platform = plate(width = 100mm, depth = 100mm, height = 6mm)
  |> translate(z = 135mm, global = true)
pedestal = union([leg, platform])
  |> appearance(color = "#879ba8", metalness = 70)
