// Dimensioned fluid routing
// Tangent arch hoses repeat at differing spans and endpoint elevations.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

export fn archTube(span, crest, terminalZ, bendRadius) {
  route = sketch(on = XZ) {
    inlet = line(start = [var 0mm, var 0mm], end = [var 0mm, var 20mm])
    firstBend = arc(
      start = [var 0mm, var 20mm],
      end = [var 10mm, var 30mm],
      center = [var 10mm, var 20mm],
      direction = CW,
    )
    bridge = line(start = [var 10mm, var 30mm], end = [var 90mm, var 30mm])
    secondBend = arc(
      start = [var 90mm, var 30mm],
      end = [var 100mm, var 20mm],
      center = [var 90mm, var 20mm],
      direction = CW,
    )
    outlet = line(start = [var 100mm, var 20mm], end = [var 100mm, var 0mm])
    coincident([inlet.start, ORIGIN])
    coincident([inlet.end, firstBend.start])
    coincident([firstBend.end, bridge.start])
    coincident([bridge.end, secondBend.start])
    coincident([secondBend.end, outlet.start])
    vertical(inlet)
    horizontal(bridge)
    vertical(outlet)
    tangent([inlet, firstBend])
    tangent([firstBend, bridge])
    tangent([bridge, secondBend])
    tangent([secondBend, outlet])
    radius(firstBend) == bendRadius
    radius(secondBend) == bendRadius
    verticalDistance([inlet.start, inlet.end]) == crest - bendRadius
    horizontalDistance([bridge.start, bridge.end]) == span - (2 * bendRadius)
    verticalDistance([ORIGIN, outlet.end]) == terminalZ
  }
  section = sketch(on = XY) {
    outerRim = circle(start = [var 0.5mm, var 0mm], center = [var 0mm, var 0mm])
    innerRim = circle(start = [var 0.25mm, var 0mm], center = [var 0mm, var 0mm])
    coincident([outerRim.center, ORIGIN])
    coincident([innerRim.center, outerRim.center])
    horizontal([outerRim.center, outerRim.start])
    horizontal([innerRim.center, innerRim.start])
    radius(outerRim) == 0.5mm
    radius(innerRim) == 0.25mm
  }
  hose = sweep(
    region(segments = [section.outerRim]),
    path = [
      route.inlet,
      route.firstBend,
      route.bridge,
      route.secondBend,
      route.outlet
    ],
    translateProfileToPath = true,
    orientProfilePerpendicular = true,
    version = 2,
  )
  hide([route, section])
  return hose
}
