// Live media reservoir route
// Connects selector input one to rear-right reservoir dip leg.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

import archTube from "fluidRouting.kcl"
lineSpan = sqrt(263_ * 263_ + 15_ * 15_) * 1mm
mediaLine = archTube(
  span = lineSpan,
  crest = 160mm,
  terminalZ = -177mm,
  bendRadius = 10mm,
)
  |> appearance(color = "#6ab7a0")
