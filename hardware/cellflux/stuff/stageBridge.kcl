// Microscope stage support
// Rear bridge joining the column to the moving stage.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

import plate from "geometry.kcl"
stock = plate(width = 300mm, depth = 90mm, height = 20mm)
columnSeat = plate(width = 65mm, depth = 56mm, height = 22mm)
  |> translate(y = 35mm, z = -1mm, global = true)
bridge = subtract(stock, tools = [columnSeat])
  |> appearance(color = "#b2bec5", metalness = 70)
