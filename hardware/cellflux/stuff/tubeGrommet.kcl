// Tubing lid grommet
// Bored compliant seal for the nominal 1 mm tubing.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

import cylinder from "geometry.kcl"
stem = cylinder(sizeDiameter = 3mm, height = 3.2mm)
flange = cylinder(sizeDiameter = 5mm, height = 1mm)
  |> translate(z = 3mm, global = true)
stock = union([stem, flange])
bore = cylinder(sizeDiameter = 1mm, height = 6mm)
  |> translate(z = -1mm, global = true)
grommet = subtract(stock, tools = [bore])
  |> appearance(color = "#34393d")
