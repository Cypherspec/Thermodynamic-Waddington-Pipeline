// Waste bottle lid
// Sealed-envelope cap with two open tube penetrations.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

import cylinder from "geometry.kcl"
stock = cylinder(sizeDiameter = 74mm, height = 8mm)
ports = cylinder(sizeDiameter = 6mm, height = 10mm)
  |> rotate(axis = Z, angle = 17deg, global = true)
  |> translate(x = -12mm, z = -1mm, global = true)
  |> patternLinear3d(instances = 2, distance = 24mm, axis = X)
lid = subtract(stock, tools = ports)
  |> appearance(color = "#c38d36", metalness = 25)
