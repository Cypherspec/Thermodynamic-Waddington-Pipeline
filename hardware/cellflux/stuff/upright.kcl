// Corner frame upright
// Hollow structural member with an axial mounting bore.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

import frame from "geometry.kcl"
postSize = 30mm
postHeight = 600mm
upright = frame(
  width = postSize,
  depth = postSize,
  openingWidth = 18mm,
  openingDepth = 18mm,
  height = postHeight,
)
  |> appearance(color = "#a6b4be", metalness = 80)
