// Enclosure roof
// Removable folded-panel envelope with service fastener holes.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

import plate, cylinder from "geometry.kcl"
stock = plate(width = 900mm, depth = 650mm, height = 4mm)
fastenerTool = cylinder(sizeDiameter = 8mm, height = 6mm)
  |> translate(
       x = -425mm,
       y = -300mm,
       z = -1mm,
       global = true,
     )
  |> patternLinear3d(instances = 2, distance = 850mm, axis = X)
  |> patternLinear3d(instances = 2, distance = 600mm, axis = Y)
roof = subtract(stock, tools = fastenerTool)
  |> appearance(color = "#dae1e5", metalness = 35)
