// Instrument foundation
// Machined base with four mounting clearances.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

import plate, cylinder from "geometry.kcl"
baseWidth = 900mm
baseDepth = 650mm
baseThickness = 20mm
stock = plate(width = baseWidth, depth = baseDepth, height = baseThickness)
mountTool = cylinder(sizeDiameter = 8mm, height = baseThickness + 2mm)
  |> translate(
       x = -425mm,
       y = -300mm,
       z = -1mm,
       global = true,
     )
  |> patternLinear3d(instances = 2, distance = 850mm, axis = X)
  |> patternLinear3d(instances = 2, distance = 600mm, axis = Y)
basePlate = subtract(stock, tools = mountTool)
  |> appearance(color = "#303d4b", metalness = 60)
