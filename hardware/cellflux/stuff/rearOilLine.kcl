// Rear oil supply route
// Continuous tube from second oil reservoir to rear focusing inlet.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

import archTube from "fluidRouting.kcl"
lineSpan = sqrt(363_ * 363_ + 13_ * 13_) * 1mm
oilLine = archTube(
  span = lineSpan,
  crest = 125mm,
  terminalZ = -271.87mm,
  bendRadius = 10mm,
)
  |> appearance(color = "#88a5d4")
