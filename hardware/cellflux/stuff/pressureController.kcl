// Pressure controller housing
// Eight-channel commercial-module stand-in with open connection recesses.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

import plate, cylinder from "geometry.kcl"
stock = plate(width = 230mm, depth = 110mm, height = 70mm)
ports = cylinder(sizeDiameter = 8mm, height = 12mm)
  |> rotate(axis = X, angle = 90deg, global = true)
  |> translate(
       x = -87.5mm,
       y = -45mm,
       z = 30mm,
       global = true,
     )
  |> patternLinear3d(instances = 8, distance = 25mm, axis = X)
controller = subtract(stock, tools = ports)
  |> appearance(color = "#e7e9e5", metalness = 35)
