// Illumination support arm
// Machined support with a condenser barrel clearance.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

import plate, cylinder from "geometry.kcl"
stock = plate(width = 70mm, depth = 200mm, height = 20mm)
barrelTool = cylinder(sizeDiameter = 45.5mm, height = 22mm)
  |> translate(y = -60mm, z = -1mm, global = true)
// Vertical liquid-feed clearance outside the condenser barrel.
feedClearance = cylinder(sizeDiameter = 3mm, height = 22mm)
  |> translate(
       x = -30mm,
       y = -60mm,
       z = -1mm,
       global = true,
     )
arm = subtract(stock, tools = [barrelTool, feedClearance])
  |> appearance(color = "#c6d1d7", metalness = 60)
